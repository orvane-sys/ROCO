#!/usr/bin/env python3
"""Runs the ROCO launcher from a clone: `scripts/roco sim|robot|replay ...`. The code is in roco_launcher.py, which is also what the
installed `roco` command runs (see pyproject.toml)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from roco_launcher import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
